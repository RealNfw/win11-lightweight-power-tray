#include <winuser.h>
#include "resource.h"

// Manifest embedding, so the app (and the CLI spike test harness) gets
// correct OS capability detection (PerMonitorV2 DPI awareness,
// supportedOS list) without any application-compatibility shimming.
1 RT_MANIFEST "../app.manifest"

// Single static tray icon resource.
IDI_APP ICON "app.ico"
